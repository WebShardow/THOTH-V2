generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// AUTHENTICATION MODELS
// ========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(user)
  password      String?   // For credentials provider
  username      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  
  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  user
  admin
  editor
}

// ========================================
// CMS CONTENT MODELS
// ========================================

model Project {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  date        DateTime  @default(now())
  thumbnail   String?
  gallery     String[]  @default([])
  videoLink   String?
  projectUrl  String?
  toolsUsed   String[]  @default([])
  tags        String[]  @default([])
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([featured])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  posts       Post[]    @relation("PostCategory")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Page {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text @default("")
  excerpt     String?   @db.Text
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  layout      String    @default("default")
  customCss   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([featured])
}

model Post {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?   @db.Text
  coverImage  String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], name: "PostCategory")
  tags        String[]  @default([])
  authorId    String?
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([featured])
  @@index([categoryId])
  @@index([publishedAt])
}

model StaffMember {
  id                String      @id @default(uuid())
  slug              String      @unique
  name              String
  role              String
  email             String?
  bio               String?     @db.Text
  avatarUrl         String?
  accentColor       String      @default("indigo")
  githubUrl         String?
  linkedinUrl       String?
  twitterUrl        String?
  websiteUrl        String?
  projectHighlights String[]    @default([])
  skills            String[]    @default([])
  sortOrder         Int         @default(0)
  featured          Boolean     @default(false)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([slug])
  @@index([featured])
  @@index([sortOrder])
}

model MenuItem {
  id            String    @id @default(uuid())
  label         String
  url           String
  icon          String?
  order         Int       @default(0)
  parentId      String?
  parent        MenuItem? @relation("MenuHierarchy", fields: [parentId], references: [id])
  children      MenuItem[] @relation("MenuHierarchy")
  isExternal    Boolean   @default(false)
  isVisible     Boolean   @default(true)
  showInNavbar  Boolean   @default(true)
  showInSidebar Boolean   @default(false)
  showInFooter  Boolean   @default(false)
  location      String    @default("main")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([parentId])
  @@index([location])
  @@index([order])
}

model SiteConfig {
  id               String   @id @default("default")
  siteName         String   @default("THOTH CMS")
  siteTagline      String   @default("Modern Headless CMS")
  domain           String   @default("")
  language         String   @default("th")
  timezone         String   @default("Asia/Bangkok")
  logoUrl          String   @default("")
  logoAlt          String   @default("Logo")
  faviconUrl       String   @default("")
  showLogoText     Boolean  @default(true)
  primaryColor     String   @default("#6366f1")
  secondaryColor   String   @default("#8b5cf6")
  accentColor      String   @default("#f59e0b")
  darkMode         Boolean  @default(false)
  socialLinks      Json     @default("{}")
  seoSettings      Json     @default("{}")
  analyticsId      String?
  customCss        String?
  customScripts    String?
  maintenanceMode  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Media {
  id              String   @id @default(uuid())
  name            String
  url             String
  thumbnailUrl    String?
  type            MediaType
  size            Int
  width           Int?
  height          Int?
  altText         String?
  caption         String?
  folder          String   @default("uploads")
  tags            String[] @default([])
  storageProvider String   @default("local")
  storageKey      String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([folder])
  @@index([createdAt])
}

enum MediaType {
  image
  video
  audio
  document
  other
}

model ApiToken {
  id          String   @id @default(uuid())
  name        String
  token       String   @unique
  permissions String[] @default(["read"])
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
  @@index([isActive])
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  events    String[] @default([])
  secret    String?
  isActive  Boolean  @default(true)
  headers   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}
