generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// AUTHENTICATION MODELS
// ========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(user)
  password      String?   // For credentials provider
  username      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  mustChangePassword Boolean @default(false)
  
  accounts      Account[]
  sessions      Session[]
  
  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  user
  admin
  editor
}

// ========================================
// CMS CONTENT MODELS
// ========================================

model Project {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  date        DateTime  @default(now())
  thumbnail   String?
  gallery     String[]  @default([])
  videoLink   String?
  projectUrl  String?
  toolsUsed   String[]  @default([])
  tags        String[]  @default([])
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([featured])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  posts       Post[]    @relation("PostCategory")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Page {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text @default("")
  excerpt     String?   @db.Text
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  layout      String    @default("default")
  customCss   String?
  sourceType  String    @default("manual")
  sourceRef   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([featured])
}

model Post {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?   @db.Text
  coverImage  String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], name: "PostCategory")
  tags        String[]  @default([])
  authorId    String?
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([featured])
  @@index([categoryId])
  @@index([publishedAt])
}

model StaffMember {
  id                String      @id @default(uuid())
  slug              String      @unique
  name              String
  role              String
  email             String?
  bio               String?     @db.Text
  avatarUrl         String?
  accentColor       String      @default("indigo")
  githubUrl         String?
  linkedinUrl       String?
  twitterUrl        String?
  websiteUrl        String?
  projectHighlights String[]    @default([])
  skills            String[]    @default([])
  sortOrder         Int         @default(0)
  featured          Boolean     @default(false)
  isActive          Boolean     @default(true)
  repos             StaffRepo[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([slug])
  @@index([featured])
  @@index([sortOrder])
}

model MenuItem {
  id            String    @id @default(uuid())
  label         String
  url           String
  icon          String?
  order         Int       @default(0)
  parentId      String?
  parent        MenuItem? @relation("MenuHierarchy", fields: [parentId], references: [id])
  children      MenuItem[] @relation("MenuHierarchy")
  isExternal    Boolean   @default(false)
  isVisible     Boolean   @default(true)
  showInNavbar  Boolean   @default(true)
  showInSidebar Boolean   @default(false)
  showInFooter  Boolean   @default(false)
  location      String    @default("main")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([parentId])
  @@index([location])
  @@index([order])
}

model SiteConfig {
  id               String   @id @default("default")
  siteName         String   @default("THOTH CMS")
  siteTagline      String   @default("Modern Headless CMS")
  domain           String   @default("")
  language         String   @default("th")
  timezone         String   @default("Asia/Bangkok")
  logoUrl          String   @default("")
  logoAlt          String   @default("Logo")
  faviconUrl       String   @default("")
  showLogoText     Boolean  @default(true)
  
  // Theme & Navigation (V1 compatibility)
  navStyle         String   @default("fixed")
  navBgColor       String   @default("#0ea5e9")
  navTextColor     String   @default("#ffffff")
  showHero         Boolean  @default(true)
  heroStyle        String   @default("centered")
  heroHeading      String   @default("Welcome to your site")
  heroSubheading   String   @default("Use the CMS to manage reusable content for any frontend application")
  heroBgColor      String   @default("#f0f9ff")
  heroTextColor    String   @default("#0f172a")
  heroImageUrl     String   @default("")
  heroBtnLabel     String   @default("Explore content")
  heroBtnColor     String   @default("#f59e0b")
  
  primaryColor     String   @default("#6366f1")
  secondaryColor   String   @default("#8b5cf6")
  accentColor      String   @default("#f59e0b")
  bgColor          String   @default("#f8fafc")
  textColor        String   @default("#1e293b")
  fontFamily       String   @default("Inter")
  layoutStyle      String   @default("grid")
  
  showSidebar      Boolean  @default(false)
  sidebarPosition  String   @default("left")
  
  footerCopyright  String   @default("© 2024 My Site")
  footerBgColor    String   @default("#1e293b")
  footerTextColor  String   @default("#94a3b8")
  
  // Social & Communication
  discordUrl       String   @default("")
  githubUrl        String   @default("")
  twitterUrl       String   @default("")
  linkedinUrl      String   @default("")
  privacyUrl       String   @default("")
  termsUrl         String   @default("")
  cookiePolicyUrl  String   @default("")
  
  darkMode         Boolean  @default(false)
  socialLinks      Json     @default("{}")
  seoSettings      Json     @default("{}")
  analyticsId      String?
  customCss        String?
  customScripts    String?
  maintenanceMode  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Media {
  id              String   @id @default(uuid())
  name            String
  url             String
  thumbnailUrl    String?
  type            MediaType
  size            Int
  width           Int?
  height          Int?
  altText         String?
  caption         String?
  folder          String   @default("uploads")
  tags            String[] @default([])
  storageProvider String   @default("local")
  storageKey      String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([folder])
  @@index([createdAt])
}

enum MediaType {
  image
  video
  audio
  document
  other
}

model ApiToken {
  id          String   @id @default(uuid())
  name        String
  token       String   @unique
  permissions String[] @default(["read"])
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
  @@index([isActive])
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  events    String[] @default([])
  secret    String?
  isActive  Boolean  @default(true)
  headers   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model SecretStore {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiAutoPostCampaign {
  id                 String          @id @default(cuid())
  name               String
  provider           String          @default("google-ai-studio")
  model              String          @default("gemini-2.5-flash")
  topic              String
  systemPrompt       String          @default("")
  slugPrefix         String
  timezone           String          @default("Asia/Bangkok")
  scheduleType       String          @default("daily")
  scheduleTime       String          @default("09:00")
  publishAsPublished Boolean         @default(false)
  isEnabled          Boolean         @default(false)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  lastResult         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  runs               AiAutoPostRun[]
}

model AiAutoPostRun {
  id         String             @id @default(cuid())
  campaignId String
  campaign   AiAutoPostCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String?
  slug       String?
  status     String             @default("queued")
  prompt     String             @default("")
  output     String             @default("")
  error      String?
  ranAt      DateTime           @default(now())

  @@index([campaignId, ranAt])
}

model StaffRepo {
  id            String      @id @default(uuid())
  name          String
  demoUrl       String?
  sourceUrl     String?
  landingUrl    String?
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
